# Backend Environment Variables for Cloud Deployment

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
# For MongoDB Cloud (MongoDB Atlas): Use the cloud URI provided by Atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/library_react_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/library_react_db?retryWrites=true&w=majority

# JWT Configuration
# Change this to a strong random string in production
JWT_SECRET=your-super-secret-key-here-change-in-production

# CORS Configuration (for frontend URL)
FRONTEND_URL=https://your-frontend-domain.com

# Cloudinary Configuration (for image upload)
# Get credentials from https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (optional - for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_FOLDER=uploads

# Add any other environment variables needed for your application
